{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "mimir-lab"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "mimir-data"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "2Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "mimir"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "mimir"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "mimir"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "mimir",
                "image": "grafana/mimir@sha256:0ed56db7d7713707eff00224ddd4c3096afa6cf1cbe43a6f9391c537f1416099",
                "args": [
                  "-config.file=/etc/lab/mimir.yaml",
                  "-activity-tracker.filepath=/data/metrics-activity.log"
                ],
                "ports": [
                  {
                    "containerPort": 9009
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "config",
                    "mountPath": "/etc/lab",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/data"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "1Gi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "workingDir": "/data",
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": 9009
                  },
                  "periodSeconds": 3,
                  "failureThreshold": 30
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": 9009
                  },
                  "periodSeconds": 3,
                  "failureThreshold": 60
                }
              }
            ],
            "volumes": [
              {
                "name": "config",
                "configMap": {
                  "name": "mimir-config"
                }
              },
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "mimir-data"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "mimir"
      },
      "spec": {
        "selector": {
          "app": "mimir"
        },
        "ports": [
          {
            "port": 9009,
            "targetPort": 9009
          }
        ]
      }
    },
